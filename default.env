WIS2DOWNLOADER_UID=10001
WIS2DOWNLOADER_GID=988

LOG_LEVEL=INFO

FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Key for encrypting subscription credentials, generated by setup.sh
SUBSCRIPTIONS_ENCRYPTION_KEY=

# Web UI session storage secret, generated by setup.sh
STORAGE_SECRET=

# Public base URL — set this to your server's IP or hostname (e.g. http://192.168.1.100)
WIS2DOWNLOADER_BASE_URL=http://localhost

WIS2DOWNLOADER_SUBSCRIPTION_MANAGER_URL=${WIS2DOWNLOADER_BASE_URL}:5002
WIS2DOWNLOADER_GRAFANA_URL=${WIS2DOWNLOADER_BASE_URL}:3000

HOST_DATA_PATH=./downloads
CONTAINER_DATA_PATH=/data

# Directory for the subscriptions backup file (subscriptions.json)
HOST_SUBSCRIPTIONS_PATH=./subscriptions

# Default retention period in days
DOWNLOAD_RETENTION_PERIOD=30

# VALKEY config
VALKEY_HOST="valkey"
VALKEY_PORT=6379
VALKEY_DATABASE=0
VALKEY_TTL_SECONDS=3600
VALKEY_MESSAGE_LOCK=300
VALKEY_PASSWORD=

CELERY_BACKEND_DB=0
CELERY_RESULT_DB=1
SCHEDULER_BACKEND_DB=2
SCHEDULER_RESULT_DB=3

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
